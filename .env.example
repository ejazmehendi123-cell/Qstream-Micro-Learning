# ==========================================
# QSTREAM AI ENVIRONMENT CONFIGURATION
# ==========================================

# Client Configuration
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Project Dashboard: https://supabase.com/dashboard/project/hataawyodibdnnjolvqc
SUPABASE_URL=https://hataawyodibdnnjolvqc.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI Configuration (OpenAI)
# If not provided, the platform uses rich internal question bank and intelligent rule-based tutor
OPENAI_API_KEY=your-openai-api-key-here
