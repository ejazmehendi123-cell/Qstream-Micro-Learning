{
  "name": "qstream-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Qstream AI - Personalized AI Learning, Quiz, Revision & Skill Development Platform",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "seed": "npm run seed --prefix server",
    "test": "npm run test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "microlearning",
    "ai",
    "education",
    "quiz",
    "spaced-repetition",
    "supabase"
  ],
  "author": "Qstream AI Team",
  "license": "MIT"
}
